# Copia este archivo como 04_despliegue_ci_cd/.env EN EL SERVIDOR y completa los valores.
# El .env real NO se sube al repositorio (está en .gitignore).

# Base de datos
POSTGRES_USER=joyeria
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
POSTGRES_DB=joyeria

# Dirección pública del sitio (la usa el agente para armar los enlaces al catálogo)
WEB_URL=http://IP-DEL-SERVIDOR

# Clave con la que se firman las sesiones del panel (mínimo 32 caracteres).
# Genera una con: openssl rand -base64 48
SESION_SECRETO=

# Meta / WhatsApp Business (ver META.md). Sin META_ACCESS_TOKEN y META_PHONE_NUMBER_ID el agente
# responde igual pero la respuesta solo queda guardada y en el registro, no se envía por WhatsApp.
META_VERIFY_TOKEN=cambia-esto
META_APP_SECRET=
# Opcional: solo si Instagram firma con la clave de su propia app (ver META.md).
META_INSTAGRAM_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v23.0

# Modelo de IA (opcional: sin clave el agente funciona con reglas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Canales de contacto con el asesor (opcionales). WhatsApp: número del bot con código de país
# (se limpian guiones y espacios). Messenger: el ID de la página (el mismo de META_PAGE_ID).
# Instagram: el usuario de la cuenta. Un canal vacío no se ofrece en la web.
JOYERIA_WHATSAPP=
JOYERIA_INSTAGRAM=
JOYERIA_MESSENGER=

# Seguridad del agente (JOY-74): mensajes que un cliente puede mandar por ventana de tiempo.
# Al pasarse recibe un aviso y el modelo no se llama hasta que la ventana vence.
AGENTE_LIMITE_MENSAJES=15
AGENTE_LIMITE_SEGUNDOS=60

# Resiliencia del agente (JOY-94): si Gemini está saturado (503) o no responde a tiempo (504),
# se espera esto y se reintenta una vez antes de pasar al modelo de respaldo. 0 lo desactiva.
AGENTE_REINTENTO_SEGUNDOS=1.5

# Escalamiento automático (JOY-85): un presupuesto mayor que esto (USD) lo atiende un asesor.
AGENTE_COTIZACION_MAXIMA=5000
