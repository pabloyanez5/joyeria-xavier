# Copia este archivo como 04_despliegue_ci_cd/.env EN EL SERVIDOR y completa los valores.
# El .env real NO se sube al repositorio (está en .gitignore).

# Base de datos
POSTGRES_USER=joyeria
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
POSTGRES_DB=joyeria

# Dirección pública del sitio (la usa el agente para armar los enlaces al catálogo)
WEB_URL=http://IP-DEL-SERVIDOR

# Meta (el webhook responde, pero todavía no se envían respuestas a Meta)
META_VERIFY_TOKEN=cambia-esto

# Modelo de IA (opcional: sin clave el agente funciona con reglas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Canales de contacto con el asesor (opcionales)
JOYERIA_WHATSAPP=
JOYERIA_INSTAGRAM=
JOYERIA_MESSENGER=
