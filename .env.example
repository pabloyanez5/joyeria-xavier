# Copia este archivo a .env y completa los valores. NO subas .env al repositorio.

# Base de datos y caché
DATABASE_URL=postgresql://usuario:clave@localhost:5432/joyeria
REDIS_URL=redis://localhost:6379/0

# Seguridad
JWT_SECRET=cambia-esto
JWT_EXPIRE_MINUTES=60

# Meta Business API
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# Proveedor de LLM
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
